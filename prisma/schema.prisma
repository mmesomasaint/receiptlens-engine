// prisma/schema.prisma
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum SubscriptionTier {
  FREE_90_DAYS
  PRO_MONTHLY
  PRO_ANNUAL
}

enum DocumentSource {
  GMAIL
  GOOGLE_DRIVE
}

enum DocumentCategory {
  RECEIPT
  INVOICE
  TAX_FORM_W9_1099
  CONTRACT
  UNKNOWN
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  fullName              String?
  googleId              String            @unique
  googleAccessToken     String?           @db.Text
  googleRefreshToken    String            @db.Text // AES-256 encrypted at rest
  tokenExpiresAt        DateTime?
  
  // Subscription & Entitlements
  tier                  SubscriptionTier  @default(FREE_90_DAYS)
  stripeCustomerId      String?           @unique
  stripeSubscriptionId  String?           @unique
  subscriptionExpiresAt DateTime?

  // Sync state
  lastSyncAt            DateTime?
  isSyncing             Boolean           @default(false)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  documents             Document[]
  syncLogs              SyncLog[]

  @@index([email])
  @@index([googleId])
}

model Document {
  id               String                 @id @default(uuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source           DocumentSource
  sourceId         String                 // Gmail Message ID or Drive File ID
  sourceChecksum   String                 // SHA-256 hash to prevent duplicate processing
  
  fileName         String
  fileSize         Int
  mimeType         String
  storagePath      String                 // Local / S3 encrypted path

  // Structured OCR metadata
  category         DocumentCategory       @default(UNKNOWN)
  merchantName     String?
  totalAmount      Decimal?               @db.Decimal(12, 2)
  currency         String                 @default("USD")
  documentDate     DateTime?
  taxYear          Int?
  rawOcrText       String                 @db.Text

  // Vector embedding (384-dimensional for all-MiniLM-L6-v2)
  embedding        Unsupported("vector(384)")?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([userId, sourceChecksum])
  @@index([userId, documentDate])
  @@index([userId, category])
  @@index([userId, taxYear])
}

model SyncLog {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          IngestionStatus @default(PENDING)
  scannedCount    Int             @default(0)
  ingestedCount   Int             @default(0)
  duplicateCount  Int             @default(0)
  failedCount     Int             @default(0)
  errorMessage    String?         @db.Text
  startedAt       DateTime        @default(now())
  completedAt     DateTime?

  @@index([userId])
}
